"use client";

import { useEffect, useState } from "react";
import { PageShell } from "../components/page-shell";
import { Panel, Badge } from "../components/ui";
import {
  createDailyTaskInSupabase,
  deleteDailyTaskFromSupabase,
  fetchDailyTasksFromSupabase,
  toggleDailyTaskCompletionInSupabase,
  type DailyTaskFormValues,
  type DailyTaskRecord,
  updateDailyTaskInSupabase,
} from "../../lib/supabase/daily-tasks";

type TaskFormState = {
  title: string;
  description: string;
  taskType: string;
  taskDate: string;
  isCompleted: boolean;
};

const emptyForm = (): TaskFormState => ({
  title: "",
  description: "",
  taskType: "Follow-up",
  taskDate: new Date().toISOString().slice(0, 10),
  isCompleted: false,
});

export default function DailyTasksPage() {
  const [tasks, setTasks] = useState<DailyTaskRecord[]>([]);
  const [form, setForm] = useState<TaskFormState>(emptyForm());
  const [editingId, setEditingId] = useState<number | null>(null);
  const [isLoading, setIsLoading] = useState(true);
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [errorMessage, setErrorMessage] = useState("");

  useEffect(() => {
    void loadTasks();
  }, []);

  async function loadTasks() {
    try {
      setIsLoading(true);
      setErrorMessage("");
      const data = await fetchDailyTasksFromSupabase();
      setTasks(data);
    } catch (error) {
      setErrorMessage(error instanceof Error ? error.message : "Unable to load daily tasks.");
    } finally {
      setIsLoading(false);
    }
  }

  async function handleSubmit(event: React.FormEvent) {
    event.preventDefault();
    if (!form.title.trim()) {
      setErrorMessage("Please add a task title.");
      return;
    }

    try {
      setIsSubmitting(true);
      setErrorMessage("");
      if (editingId !== null) {
        const updated = await updateDailyTaskInSupabase(editingId, {
          title: form.title,
          description: form.description,
          taskType: form.taskType,
          taskDate: form.taskDate,
          isCompleted: form.isCompleted,
        });
        setTasks((current) => current.map((task) => (task.id === updated.id ? updated : task)));
      } else {
        const created = await createDailyTaskInSupabase({
          title: form.title,
          description: form.description,
          taskType: form.taskType,
          taskDate: form.taskDate,
          isCompleted: form.isCompleted,
        });
        setTasks((current) => [created, ...current]);
      }
      setForm(emptyForm());
      setEditingId(null);
    } catch (error) {
      setErrorMessage(error instanceof Error ? error.message : "Unable to save the task.");
    } finally {
      setIsSubmitting(false);
    }
  }

  async function handleDelete(id: number) {
    try {
      setErrorMessage("");
      await deleteDailyTaskFromSupabase(id);
      setTasks((current) => current.filter((task) => task.id !== id));
    } catch (error) {
      setErrorMessage(error instanceof Error ? error.message : "Unable to delete the task.");
    }
  }

  async function handleToggleComplete(task: DailyTaskRecord) {
    try {
      setErrorMessage("");
      const updated = await toggleDailyTaskCompletionInSupabase(task.id, !task.is_completed);
      setTasks((current) => current.map((item) => (item.id === updated.id ? updated : item)));
    } catch (error) {
      setErrorMessage(error instanceof Error ? error.message : "Unable to update completion status.");
    }
  }

  function startEdit(task: DailyTaskRecord) {
    setEditingId(task.id);
    setForm({
      title: task.title,
      description: task.description,
      taskType: task.task_type,
      taskDate: task.task_date,
      isCompleted: task.is_completed,
    });
  }

  const completedCount = tasks.filter((task) => task.is_completed).length;
  const remainingCount = tasks.length - completedCount;
  const progressPercent = tasks.length ? Math.round((completedCount / tasks.length) * 100) : 0;

  return (
    <PageShell
      title="Daily Tasks"
      description="A focused, mobile-friendly workspace for your day’s most important responsibilities."
    >
      <div className="grid gap-5 xl:grid-cols-[1.05fr_0.95fr]">
        <div className="space-y-5">
          <Panel title="Today’s priorities" description="Stay ahead of urgent tasks and team support actions.">
            {isLoading ? (
              <div className="rounded-[1.25rem] border border-dashed border-slate-200 bg-slate-50 px-4 py-6 text-sm text-slate-500">
                Loading tasks from Supabase...
              </div>
            ) : (
              <div className="space-y-3">
                {tasks.map((item) => (
                  <div
                    key={item.id}
                    className={`rounded-[1.5rem] border px-4 py-4 ${item.is_completed ? "border-slate-200 bg-slate-50" : "border-slate-300 bg-white"}`}
                  >
                    <div className="flex items-start justify-between gap-3">
                      <div>
                        <p className="font-semibold text-slate-950">{item.title}</p>
                        <p className="mt-1 text-sm text-slate-500">{item.description || "No description yet."}</p>
                        <div className="mt-3 flex flex-wrap gap-2 text-xs text-slate-500">
                          <span className="rounded-full bg-slate-100 px-2.5 py-1">{item.task_type}</span>
                          <span className="rounded-full bg-slate-100 px-2.5 py-1">{item.task_date}</span>
                        </div>
                      </div>
                      <div className="flex flex-col items-end gap-2">
                        <Badge label={item.is_completed ? "Done" : "Open"} variant={item.is_completed ? "soft" : "solid"} />
                        <div className="flex flex-wrap gap-2">
                          <button
                            type="button"
                            onClick={() => void handleToggleComplete(item)}
                            className="rounded-full border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-100"
                          >
                            {item.is_completed ? "Reopen" : "Complete"}
                          </button>
                          <button
                            type="button"
                            onClick={() => startEdit(item)}
                            className="rounded-full border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-100"
                          >
                            Edit
                          </button>
                          <button
                            type="button"
                            onClick={() => void handleDelete(item.id)}
                            className="rounded-full border border-rose-200 px-3 py-2 text-sm font-semibold text-rose-700 transition hover:bg-rose-50"
                          >
                            Delete
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </Panel>

          <Panel title="Task controls" description="Actions to clear work and align with team priorities.">
            <form onSubmit={handleSubmit} className="space-y-4">
              <div className="grid gap-3 sm:grid-cols-2">
                <label className="flex flex-col gap-2 text-sm font-medium text-slate-700">
                  Title
                  <input
                    value={form.title}
                    onChange={(event) => setForm((current) => ({ ...current, title: event.target.value }))}
                    className="rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:bg-white"
                    placeholder="Task title"
                  />
                </label>
                <label className="flex flex-col gap-2 text-sm font-medium text-slate-700">
                  Task Type
                  <select
                    value={form.taskType}
                    onChange={(event) => setForm((current) => ({ ...current, taskType: event.target.value }))}
                    className="rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:bg-white"
                  >
                    <option value="Follow-up">Follow-up</option>
                    <option value="Training">Training</option>
                    <option value="Content">Content</option>
                    <option value="Admin">Admin</option>
                    <option value="Meeting">Meeting</option>
                  </select>
                </label>
              </div>
              <label className="flex flex-col gap-2 text-sm font-medium text-slate-700">
                Description
                <textarea
                  value={form.description}
                  onChange={(event) => setForm((current) => ({ ...current, description: event.target.value }))}
                  rows={4}
                  className="rounded-[1.25rem] border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:bg-white"
                  placeholder="Describe the task"
                />
              </label>
              <div className="grid gap-3 sm:grid-cols-2">
                <label className="flex flex-col gap-2 text-sm font-medium text-slate-700">
                  Task Date
                  <input
                    type="date"
                    value={form.taskDate}
                    onChange={(event) => setForm((current) => ({ ...current, taskDate: event.target.value }))}
                    className="rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:bg-white"
                  />
                </label>
                <label className="flex items-center gap-2 rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm font-medium text-slate-700">
                  <input
                    type="checkbox"
                    checked={form.isCompleted}
                    onChange={(event) => setForm((current) => ({ ...current, isCompleted: event.target.checked }))}
                  />
                  Mark complete
                </label>
              </div>
              {errorMessage ? (
                <div className="rounded-[1.25rem] border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">
                  {errorMessage}
                </div>
              ) : null}
              <div className="flex flex-wrap gap-3">
                <button
                  type="submit"
                  disabled={isSubmitting}
                  className="rounded-full bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-70"
                >
                  {isSubmitting ? "Saving..." : editingId ? "Save Task" : "Add Task"}
                </button>
                {editingId ? (
                  <button
                    type="button"
                    onClick={() => {
                      setEditingId(null);
                      setForm(emptyForm());
                    }}
                    className="rounded-full border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100"
                  >
                    Cancel
                  </button>
                ) : null}
              </div>
            </form>
          </Panel>
        </div>

        <div className="space-y-5">
          <Panel title="Daily summary" description="Quick metrics for your current workflow.">
            <div className="grid gap-3">
              <div className="rounded-3xl bg-slate-950 p-5 text-white">
                <p className="text-sm text-slate-300">Total tasks</p>
                <p className="mt-3 text-3xl font-semibold">{tasks.length}</p>
              </div>
              <div className="rounded-3xl bg-slate-50 p-5 text-slate-950">
                <p className="text-sm text-slate-500">Completed tasks</p>
                <p className="mt-3 text-3xl font-semibold">{completedCount}</p>
              </div>
              <div className="rounded-3xl bg-slate-50 p-5 text-slate-950">
                <p className="text-sm text-slate-500">Remaining tasks</p>
                <p className="mt-3 text-3xl font-semibold">{remainingCount}</p>
              </div>
              <div className="rounded-3xl border border-slate-200 bg-white p-5 text-slate-950">
                <p className="text-sm text-slate-500">Daily progress</p>
                <p className="mt-3 text-3xl font-semibold">{progressPercent}%</p>
              </div>
            </div>
          </Panel>

          <Panel title="Weekly rhythm" description="Use a consistent daily structure to maintain team momentum.">
            <p className="text-sm leading-6 text-slate-600">
              Start with your highest-value follow-ups, then set aside focused time for training, content updates, and progress check-ins.
            </p>
          </Panel>
        </div>
      </div>
    </PageShell>
  );
}
